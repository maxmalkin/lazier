"┌[1]─Status───────┌ Keys ────────────────────────────────────────────────────────┐─────────────────┐"
"│main (no upstream│ Global                                                       │─────────────────│"
"└─────────────────│  tab / shift-tab  cycle the panes                            │                 │"
"┌[2]─Files────────│        1 2 3 4 5  go to a panel                              │                 │"
"│    ▾ /          │                0  go to the diff pane                        │                 │"
"│  ?   notes.txt  │            j / k  move the selection                         │─────────────────│"
"│      ▾ src/     │  ctrl-d / ctrl-u  move one page                              │                 │"
"│  A     app.rs   │            g / G  go to the top or the end                   │                 │"
"│ MM     main.rs  │            J / K  scroll the diff pane                       │                 │"
"└─────────────────│                r  read the repository again                  │                 │"
"┌[3]─Branches─────│            / esc  search the commit messages, or show them   │                 │"
"│  2h * main ↑2   │all                                                           │                 │"
"│  1d   feature/ui│                :  run a command line through the shell       │                 │"
"│  3w   old/thing │        P / p / f  push, pull, or fetch, in the background    │                 │"
"│                 │                F  force push, with a lease that protects     │                 │"
"└─────────────────│other people                                                  │                 │"
"┌[4]─Commits──────│        W / M / U  worktrees, submodules, where HEAD has been │                 │"
"│0a0c000 TA ●↑ fak│        ? / @ / q  help, command log, quit                    │                 │"
"│0a0c001 TA ◉─╮↑ f│──────────────────────────────────────────────────────────────│                 │"
"│0a0c002 TA ● │ fa│ Files [2]                                                    │─────────────────┘"
"│0a0c003 TA │ ● fa│            space  stage or unstage the file or the directory │─────────────────┐"
"│0a0c004 TA ●─╯ fa│                a  stage all files                            │                 │"
"└─────────────────│            enter  open the hunks, or fold the directory      │                 │"
"┌[5]─Stash────────│                d  discard the changes (it asks first)        │                 │"
"│stash@{0}: WIP on│                x  delete it from the disk (it asks first)    │                 │"
"│                 │                i  ignore it: i shares the rule, e keeps it to│                 │"
"│                 │yourself                                                      │                 │"
"│                 │                A  add the staged changes to the last commit  │                 │"
