"┌[1] Status───────┌ Keys ────────────────────────────────────────────────────────┐─────────────────┐"
"│main ↑2          │ Global                                                       │                 │"
"└─────────────────│  tab / shift-tab  cycle the panes                            │                 │"
"┌[2] Files────────│        1 2 3 4 5  go to a panel                              │                 │"
"│ ? notes.txt     │                0  go to the diff pane                        │                 │"
"│  ▾ src/         │            j / k  move the selection                         │                 │"
"│ A   app.rs      │  ctrl-d / ctrl-u  move one page                              │                 │"
"│SM   main.rs     │            g / G  go to the top or the end                   │                 │"
"│                 │            J / K  scroll the diff pane                       │                 │"
"└─────────────────│                r  read the repository again                  │                 │"
"┌[3] Branches─────│        ? / @ / q  help, command log, quit                    │                 │"
"│  feature/ui     │──────────────────────────────────────────────────────────────│                 │"
"│* main           │ Files [2]                                                    │                 │"
"│                 │            space  stage or unstage the file or the directory │                 │"
"│                 │                a  stage all files                            │                 │"
"└─────────────────│            enter  open the hunks, or fold the directory      │                 │"
"┌[4] Commits──────│            c / C  commit here, or commit in the editor       │                 │"
"│● ↑ 0a0c000 fake:│                s  put the changes in a stash                 │                 │"
"│◉─╮ ↑ 0a0c001 fak│            o / t  take ours or theirs in a conflict          │                 │"
"│● │  0a0c002 fake│──────────────────────────────────────────────────────────────│                 │"
"││ ●  0a0c003 fake│ Branches [3]                                                 │─────────────────┘"
"│●─╯  0a0c004 fake│            enter  check out the branch                       │─────────────────┐"
"└─────────────────│            n / d  make a new branch, or delete this one      │                 │"
"┌[5] Stash────────│        P / p / f  push, pull, or fetch                       │                 │"
"│stash@{0}: WIP on│──────────────────────────────────────────────────────────────│                 │"
"│                 │ Commits [4]                                                  │                 │"
"│                 │            enter  open the full graph view                   │                 │"
"│                 │                i  start an interactive rebase here           │                 │"
"└─────────────────└──────────────────────────────────────────────────────────────┘─────────────────┘"
"press any key to close the help                                                                     "
